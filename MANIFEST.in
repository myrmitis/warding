# MANIFEST.in — controls what goes into the source distribution (sdist).
#
# The wheel gets its package data from setup.cfg [options.package_data] plus the
# custom BuildWithFrontend step in setup.py (which copies the pre-built
# src/junction/static/dist tree into build_lib). The sdist, however, is built
# from this file's rules, so we must explicitly ship the same data here —
# especially the built dashboard under static/dist/, which is .gitignored and
# deliberately excluded from the package_data globs (Vite emits content-hashed
# filenames, so it cannot be globbed by a stable pattern in setup.cfg).

# --- Project metadata / docs at the repo root --------------------------------
include README.md
include CHANGELOG.md
include LICENSE
include pyproject.toml
include setup.cfg
include setup.py

# --- Top-level package data files (mirror [options.package_data]) ------------
include src/junction/py.typed
include src/junction/slack-manifest.yaml
include src/junction/model_tokens.json

# --- The built dashboard SPA --------------------------------------------------
# Excluded from package_data globs and .gitignored, but it MUST ship so that a
# `pip install .` / sdist install serves the dashboard with no npm/node present.
recursive-include src/junction/static *

# --- Other package_data directories ------------------------------------------
recursive-include src/junction/config *
recursive-include src/junction/connections *.json
recursive-include src/junction/apps *.json
# ATTRIBUTION.md / README.md under a builtin app carry the upstream-author credit
# for apps ported from third-party work; Apache-2.0 attribution must ship.
recursive-include src/junction/apps *.md
recursive-include src/junction/eval/scenarios *.json
recursive-include src/junction/docs *.md
recursive-include src/junction/tests_fixtures *

# --- Pruning: never ship test trees, vendored node deps, or build cruft ------
prune test
prune tests
# In-package `tests/` is deliberately NOT pruned: `code_review_sage` (16 files) and
# `issue_radar` (11) ship theirs, so that is the established convention for a builtin app and
# changing it belongs in its own change.
prune website/node_modules
prune build
prune dist
prune .hypothesis
prune temp-screenshots
prune bench_baselines
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.so
global-exclude .DS_Store
recursive-include src/junction/deploy/skills *
# Re-include the vendored llama.cpp runtime AFTER the excludes: the
# `global-exclude *.so` above strips exactly `libllama.so` (the Linux libs whose
# names end in `.so.0` and the macOS/Windows libs escape the glob), and
# `python -m build` builds the wheel FROM the sdist, so without this line every
# published Linux wheel ships a vendored llama_cpp that cannot load its own
# shared library and in-process embeddings fail at gateway startup.
recursive-include src/junction/_vendor/llama_cpp_libs *
