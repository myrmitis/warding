{
  "name": "my-app",
  "version": "1.0.0",
  "displayName": "My App",
  "description": "Monitor tickets, pipelines, and alarms for your on-call rotation",
  "author": "junction",
  "tags": ["oncall", "monitoring"],
  "agents": ["agents/triage-agent.json"],
  "skills": ["skills/ops-runbook"],
  "crons": [
    {
      "name": "ticket-refresh",
      "every": 300,
      "message": "Check for new high-severity tickets and summarize status"
    }
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/my-app",
        "label": "Tickets",
        "icon": "Shield"
      }
    ]
  },
  "permissions": {
    "api": ["/api/tickets", "/api/status", "/api/agents"],
    "events": ["notification", "slots"]
  }
}
