---
/**
 * A night-step heading: the clock time sits on the same line as the title,
 * in Departure Mono and lamp amber, rather than as a label above it.
 * `id` anchors the step.
 */
interface Props { time: string; title: string; step?: number; id?: string; as?: "h2" | "h3" }
const { time, title, step, id, as: Tag = "h2" } = Astro.props;
---
<Tag class="clock-title" id={id} data-step={step}>
  <span class="clock clock-time">{time}</span> {title}
</Tag>
<style>
  .clock-time { color: var(--lamp); font-size: 0.85em; line-height: 1; margin-right: 0.4em; white-space: nowrap; }
</style>
