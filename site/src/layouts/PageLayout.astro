---
import BaseLayout from "./BaseLayout.astro";
import WardBars from "../components/WardBars.astro";
import InstallTabs from "../islands/InstallTabs";
import { breadcrumbList } from "../lib/seo";

/**
 * Inner-page layout for the phase-2 page agents: breadcrumbs (with
 * BreadcrumbList JSON-LD), the page's one H1, and the register. Pages built
 * from a collection get their OG PNG automatically; a static page must also
 * be listed in src/lib/og-pages.ts (the structure test checks the file exists).
 */
interface Props {
  title: string;
  description: string;
  h1: string;
  register?: "paper" | "night";
  breadcrumbs?: { label: string; href: string }[];
  lead?: string;
  ogSlug?: string;
  jsonLd?: Record<string, unknown>[];
  /**
   * The closing install band; off for pages that are not about trying it (terms, privacy) or already end on it.
   * Its block carries no #install: the nav's Install goes to the home page's, and a page body may have its own.
   */
  endBand?: boolean;
}
const { title, description, h1, register = "paper", breadcrumbs = [], lead = "", ogSlug, jsonLd = [], endBand = true } = Astro.props;
const crumbs = [{ label: "Warding", href: "/" }, ...breadcrumbs];
const ld = [...jsonLd, ...(breadcrumbs.length ? [breadcrumbList(crumbs)] : [])];
---
<BaseLayout title={title} description={description} register={register} ogSlug={ogSlug} jsonLd={ld}>
  <div class={register === "night" ? "vault" : "paper"}>
    <div class="wrap page-head">
      {breadcrumbs.length > 0 && (
        <nav class="crumbs caption" aria-label="Breadcrumb">
          <ol>
            {crumbs.map((c, i) => (
              <li>{i < crumbs.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )}
      <WardBars align="left" />
      <h1>{h1}</h1>
      {lead && <p class="lead measure">{lead}</p>}
    </div>
    <div class="wrap page-body">
      <slot />
    </div>
  </div>
  {endBand && (
    <div class="vault page-end-band">
      <section class="wrap page-end" aria-labelledby="page-end-h">
        <WardBars align="left" />
        <h2 id="page-end-h">Try it on your own box.</h2>
        <p class="lead measure">Free and Apache-2.0: a clone, a script, and the agent you already use.</p>
        <div class="page-end-install"><InstallTabs client:visible star anchor="" /></div>
      </section>
    </div>
  )}
</BaseLayout>
<style>
  .page-head { padding-block: 72px 8px; display: grid; gap: 18px; }
  .page-head h1 { font-size: clamp(2.85rem, 1.5rem + 3.4vw, 4.5rem); line-height: 0.98; letter-spacing: -0.032em; }
  .page-head .lead { font-size: 1.3125rem; line-height: 1.45; }
  .page-body { padding-block: 28px 96px; }
  .page-end-band { border-top: 1px solid var(--line); }
  .page-end { display: grid; gap: 18px; padding-block: 88px 104px; }
  .page-end h2 { font-size: clamp(2.25rem, 1.4rem + 2vw, 3.25rem); letter-spacing: -0.028em; }
  .page-end-install { max-width: 720px; }
  .crumbs { letter-spacing: 0.04em; }
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .crumbs li + li::before { content: "/"; margin-right: 6px; color: var(--fg-3); }
  .crumbs a { color: var(--fg-2); display: inline-block; padding-block: 13px; margin-block: -13px; }
</style>
