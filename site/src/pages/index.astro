---
// Website copy revised by Myrmitis on 2026-10-08; inherited legal attribution preserved in NOTICE.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ScheduleConcept from "../components/ScheduleConcept.astro";
import Button from "../components/Button.astro";
import MessageSquare from "@lucide/astro/icons/message-square";
import CalendarDays from "@lucide/astro/icons/calendar-days";
import ListChecks from "@lucide/astro/icons/list-checks";
import Boxes from "@lucide/astro/icons/boxes";
import Settings from "@lucide/astro/icons/settings";
import { site } from "../data/site";
import { organization, softwareApplication, webSite } from "../lib/seo";
import desk from "../assets/launch/late-desk.png";

const features = [
  { title: "Chat, with context", copy: "Resume conversations and keep project memory between sessions.", icon: MessageSquare },
  { title: "Schedules", copy: "Create recurring jobs in the dashboard or CLI.", icon: CalendarDays },
  { title: "Checkpointed tasks", copy: "Plan, execute, validate and resume from checkpoints.", icon: ListChecks },
  { title: "Background agents", copy: "Start focused subagents from the dashboard or CLI.", icon: Boxes },
  { title: "Optional approvals", copy: "Enable Interactive mode for gated tool calls to wait for you.", icon: Settings },
];
const steps = [
  { title: "Bring your agent", copy: "Install and sign in to a supported coding-agent CLI." },
  { title: "Open your workspace", copy: "The intended setup builds from source. Public source is available on GitHub." },
  { title: "Give the work a shape", copy: "Start a chat, add a schedule or run a task. Review it in the dashboard." },
];
---
<BaseLayout title="Warding — A local workspace for coding agents" description="Warding by Myrmitis: a local workspace for coding agents, with chat, schedules and optional approvals. Public source available." register="night" footerRegister="paper" navWide bodyClass="product-home" jsonLd={[organization(), softwareApplication(), webSite()]}>
  <section class="hero" aria-labelledby="home-heading">
    <div class="hero-art" aria-hidden="true">
      <Image src={desk} alt="A warm desk lamp beside a laptop in a quiet workspace." widths={[640, 960, 1440]} sizes="(max-width: 700px) 1px, 65vw" format="webp" quality={80} loading="eager" />
    </div>
    <div class="wrap-wide hero-copy">
      <span class="beta-badge">Local beta · Public source available</span>
      <p class="category">A local workspace for coding agents</p>
      <h1 id="home-heading">Your coding agent.<br />A workspace of its own.</h1>
      <p class="hero-lead">Bring the coding-agent CLI you already use. Warding adds a browser workspace for chat, schedules, checkpointed tasks and optional approvals on your own machine.</p>
      <div class="actions"><Button href="/verified/">Read beta notes</Button><Button href={site.sourceStatus} variant="outline">Source status</Button></div>
    </div>
    <div class="wrap-wide product-preview">
      <ScheduleConcept />
      <p class="runtime-note">Harness support varies. Schedules, channels and overnight runs are not yet runtime-verified.</p>
      <ul class="facts" aria-label="Beta essentials"><li>Apache-2.0</li><li>Runs on your machine</li><li>Your own agent login</li></ul>
    </div>
  </section>

  <section class="paper feature-section" id="product" aria-labelledby="features-heading">
    <div class="wrap-wide">
      <p class="eyebrow">Your work, in view</p>
      <h2 id="features-heading">More structure for work that takes time.</h2>
      <div class="feature-grid">
        {features.map(({ title, copy, icon: Icon }) => <article class="feature-card"><Icon aria-hidden="true" /><h3>{title}</h3><p>{copy}</p></article>)}
      </div>
      <p class="limit-note">Capabilities and approval behavior vary by harness and launch path. <a href="/verified/">Read the beta notes.</a></p>
    </div>
  </section>

  <section class="paper setup-section" id="how-it-works" aria-labelledby="setup-heading">
    <div class="wrap-wide">
      <p class="eyebrow">Start with what you use</p>
      <h2 id="setup-heading">Bring an agent. Set up the desk.</h2>
      <ol class="setup-steps">{steps.map((step, i) => <li><span class="step-number" aria-hidden="true">0{i + 1}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol>
    </div>
  </section>

  <section class="paper memory-section" aria-labelledby="memory-heading">
    <div class="wrap-wide memory-grid">
      <div><p class="eyebrow">A place for the context</p><h2 id="memory-heading">Keep the context.<br />Choose the harness.</h2><p>Chat with one chosen harness. Warding keeps your schedules, channels and project memory when you switch.</p><p class="limit-note">Provider terms and usage limits apply. An optional spawned subagent can use another installed harness; those routed runs are not yet runtime-verified.</p><a class="text-link" href="/registry/">Explore harness support <span aria-hidden="true">→</span></a></div>
      <figure class="desk-detail"><Image src={desk} alt="Concept art of a quiet workspace with a warm lamp and a laptop." widths={[480, 800]} sizes="(max-width: 700px) 100vw, 45vw" format="webp" quality={80} loading="lazy" /><figcaption>Workspace concept art · not a product screenshot</figcaption></figure>
    </div>
  </section>

  <section class="vault start-section" id="install" aria-labelledby="start-heading">
    <div class="wrap-wide"><p class="eyebrow">Your agent. Your machine.</p><h2 id="start-heading">Read the local beta notes.</h2><p>Public source is available on GitHub. Review the capabilities and limits before planning a setup.</p><Button href="/verified/">Read beta notes</Button><p class="beta-footnote">One operator, one machine. Public source is available; clean-machine setup remains unqualified.</p></div>
  </section>
  <section class="paper provenance"><div class="wrap-wide"><p>Warding by Myrmitis is Apache-2.0 software derived from an open-source agent workspace. Required attribution remains in <a href={site.links.notice}>NOTICE</a>. <a href="/lineage/">Read the project lineage.</a></p></div></section>
</BaseLayout>
<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding-top: 40px; }
  .hero-art { position: absolute; z-index: -1; top: -72px; right: 0; width: 68%; height: 630px; }
  .hero-art :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .hero-art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, #0B0E14 0%, rgba(11,14,20,.6) 42%, rgba(11,14,20,.15)), linear-gradient(0deg, #0B0E14, transparent 55%); }
  .hero-copy { position: relative; padding-bottom: 64px; }
  .beta-badge { display: inline-block; border: 1px solid #665232; border-radius: 4px; padding: 6px 10px; color: #FFD99E; font: 500 .75rem var(--font-sans); letter-spacing: .08em; text-transform: uppercase; background: #181A1E; }
  .category { margin: 24px 0 16px; color: #C8CDD6; font-size: .9375rem; }
  h1 { max-width: 880px; font-size: clamp(2.6rem, 5vw, 4.65rem); line-height: 1.08; letter-spacing: -.035em; margin: 0; }
  .hero-lead { max-width: 580px; color: #C8CDD6; font-size: 1.125rem; line-height: 1.7; margin: 26px 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .product-preview { padding-bottom: 36px; }
  .runtime-note { text-align: center; color: #B8C0CB; font-size: .875rem; margin: 20px auto 18px; max-width: 760px; }
  .facts { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px 32px; list-style: none; padding: 0; margin: 0; font-size: .875rem; color: #E1DBD1; }
  .facts li + li::before { content: "·"; color: #A69982; margin-right: 32px; }
  .feature-section { padding-block: 88px 64px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .13em; font-size: .75rem; font-weight: 600; margin: 0 0 16px; color: var(--fg-2); }
  h2 { max-width: 760px; font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1.16; letter-spacing: -.025em; margin: 0; }
  h3 { font-size: 1.25rem; line-height: 1.3; margin: 18px 0 10px; }
  .feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 36px 0 24px; }
  .feature-card { border: 1px solid var(--line); border-radius: 8px; padding: 26px; background: var(--surface); }
  .feature-card :global(svg) { width: 24px; height: 24px; color: var(--seal); stroke-width: 1.5; }
  .feature-card p, .setup-steps p { color: var(--fg-2); line-height: 1.65; margin: 0; }
  .limit-note { font-size: .875rem; color: var(--fg-2); line-height: 1.65; }
  .setup-section { padding-block: 40px 88px; }
  .setup-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; list-style: none; padding: 0; margin: 38px 0 0; }
  .setup-steps li { border-top: 1px solid var(--line); padding-top: 24px; }
  .step-number { color: var(--seal); font-size: .875rem; }
  .memory-section { padding-block: 16px 88px; }
  .memory-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  .memory-grid p:not(.eyebrow) { max-width: 520px; line-height: 1.7; }
  .text-link { display: inline-block; padding-block: 12px; }
  .desk-detail { margin: 0; }
  .desk-detail :global(img) { width: 100%; height: 300px; object-fit: cover; border-radius: 8px; }
  .desk-detail figcaption { margin-top: 10px; color: var(--fg-2); font-size: .75rem; }
  .start-section { padding-block: 72px; text-align: center; }
  .start-section h2 { margin-inline: auto; }
  .start-section p:not(.eyebrow) { color: #C8CDD6; margin: 20px auto 24px; }
  .start-section .beta-footnote { font-size: .8125rem; margin-bottom: 0; }
  .provenance { padding-block: 24px; border-bottom: 1px solid var(--line); }
  .provenance p { font-size: .8125rem; line-height: 1.7; color: var(--fg-2); max-width: 920px; margin: 0; }
  @media (max-width: 900px) { .feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .memory-grid { gap: 32px; } }
  @media (max-width: 700px) {
    .hero { padding-top: 28px; } .hero-art { display: none; } .hero-copy { padding-bottom: 36px; }
    h1 { font-size: clamp(2.25rem, 8.8vw, 3.4rem); } .hero-lead { font-size: 1rem; margin-block: 22px; }
    .category { font-size: .8125rem; } .facts { gap: 10px 18px; font-size: .75rem; } .facts li + li::before { margin-right: 18px; }
    .runtime-note { font-size: .8125rem; text-align: left; } .feature-section { padding-block: 56px 36px; }
    .feature-grid, .setup-steps, .memory-grid { grid-template-columns: minmax(0, 1fr); }
    .feature-card { padding: 22px; } .setup-section { padding-block: 28px 56px; } .setup-steps { gap: 24px; }
    .memory-section { padding-bottom: 56px; } .desk-detail :global(img) { height: 250px; }
    .start-section { padding-block: 56px; }
  }
</style>
