      </div>
      <p class="caption">
        {site.links.calendar ? <a href={site.links.calendar} rel="noopener" data-track="pilot_call_click">Teams: book a 30-minute call</a> : "Teams: calls open soon."}
      </p>
      <p class="caption release-note">Get the release note: <a href={releases} rel="noopener">Watch → Custom → Releases on GitHub</a></p>
    </section>
  </div>
</BaseLayout>

